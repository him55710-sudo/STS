# ── Supabase Auth (Google 로그인 / 게스트 둘러보기) ───────────────
# 설정하면 로그인 화면의 "Google로 계속하기"가 실제 OAuth로 동작합니다.
# 없으면 데모 로그인으로 자동 fallback 됩니다.
#
#  1) Supabase 프로젝트 > Project Settings > API 에서 값 복사
#  2) Vercel 환경변수에 아래 두 개를 등록 (둘 다 NEXT_PUBLIC_ 접두사 필수)
#  3) Supabase 대시보드 Authentication > Providers > Google 에
#     Google 콘솔에서 발급한 Client ID / Client Secret 입력 (Vercel 아님!)
#  4) Supabase Authentication > URL Configuration 에서
#     - Site URL: https://sts-mongben.vercel.app
#     - Redirect URLs: https://sts-mongben.vercel.app/auth/callback ,
#                      http://localhost:3000/auth/callback
#  5) Google Cloud Console OAuth 클라이언트의 승인된 리디렉션 URI에
#     https://<project-ref>.supabase.co/auth/v1/callback 추가
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API 키 (선택) — 설정하면 업로드 이미지에 대해 실제 AI 객체 탐지가 동작합니다.
# 없으면 데모 mock 탐지로 자동 fallback 됩니다.
GEMINI_API_KEY=
# 탐지에 사용할 모델 (기본: gemini-3.5-flash)
GEMINI_MODEL=

# ── Letsur Platform (주 LLM provider) ──────────────────────────
# https://platform.letsur.ai — 발급받은 API 키 (sk-...)
# 설정하면 객체 탐지·상품 조사에서 Gemini보다 우선 사용됩니다.
LETSUR_API_KEY=
# base URL. 비워두면 자동 probe 합니다.
# 프로덕션 실측: https://api.letsur.ai/v1 만 실제 API 응답을 반환했습니다.
LETSUR_BASE_URL=https://api.letsur.ai/v1
# 인증 헤더 방식: bearer | x-api-key. 비우면 둘 다 시도 후 성공한 쪽을 사용합니다.
LETSUR_AUTH_STYLE=
# 사용할 모델 ID (/api/vision-health 의 availableModels 에서 비전 지원 모델 선택)
LETSUR_MODEL=
# 관리(Management) API 키 (mk_...) — 스페이스/모델 조회 진단용. 비전 호출에는 쓰지 않음.
LETSUR_MANAGEMENT_KEY=

# provider 강제 지정 (비교·롤백용): letsur | gemini.
# 비우면 gemini → letsur 순서 (Letsur는 게이트웨이 차단 판정으로 보류 — docs/VISION.md).
LLM_PROVIDER=

# ── 네이버 검색 API (선택) — 상품 후보 시각 검증용 ──────────────
#
# ⚠️ 쇼핑 검색 API는 종료되었습니다.
#    네이버 개발자센터 이용약관 부칙 제2조 ③ (시행 2026-07-31):
#    "Search API 중 '쇼핑', '책', '학술정보' 서비스는 2026-07-31 24:00부로 종료"
#    → /v1/search/shop.json 은 키를 바꿔도 되살아나지 않습니다. 호출하지 않습니다.
#
# 현재 쓰는 것: **이미지 검색**. 상품명으로 실제 상품 이미지를 찾아 대표색을 서버에서
# 계산하고, 업로드 사진의 마스크 색과 비교해 재랭킹의 visual 축을 채웁니다.
# (검색 이미지는 제3자 저작물이므로 점수 계산에만 쓰고 화면에 노출하지 않습니다.)
#
# 계약(contract)이 두 가지입니다. 아무것도 지정하지 않으면 둘 다 시도합니다.
#
# [1] apihub — 신규. NAVER API HUB (네이버클라우드플랫폼 콘솔에서 발급)
#     https://naverapihub.apigw.ntruss.com/search/v1/{type}
#     헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_APIGW_API_KEY_ID=
NAVER_APIGW_API_KEY=
#
# [2] legacy — 구 개발자센터 (2027-06-30 종료 예정)
#     https://openapi.naver.com/v1/search/{type}.json
#     헤더 X-Naver-Client-Id / X-Naver-Client-Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
#
# 계약 강제 지정 (진단·롤백용): apihub | legacy. 비우면 자동 판별 후 캐시.
NAVER_API_CONTRACT=

# 참고: GEMINI_API_KEY가 무료 티어면 일일 쿼터(요청 수)가 작아
# 정밀 탐지·웹 상품 검색(구글 검색 그라운딩)이 자주 429로 막힙니다.
# 프로덕션에서는 유료(pay-as-you-go) 전환을 권장합니다.

# ── STS local catalog (개발 환경 선택) ────────────────────────
# 비우면 프로젝트 상위의 `STS image/assets`를 자동으로 읽습니다.
# 배포 환경에서는 업로드 스토리지/카탈로그 DB로 대체하세요.
STS_LOCAL_IMAGE_DIR=

# ── Catalog freshness sync (server-only) ──────────────────────
# /api/catalog-sync 보호용 서버 시크릿. 브라우저 환경변수로 노출하지 마세요.
STS_CATALOG_SYNC_SECRET=
# 동기화 대상 카탈로그 공급자. 비우면 fixture 모드로 동작합니다.
CATALOG_PROVIDER=
# live 공급자를 사용할 때만 지정하는 피드/API 주소.
CATALOG_FEED_URL=
# 공급자 계약에서 토큰이 필요한 경우에만 사용하는 서버 전용 값.
CATALOG_FEED_TOKEN=

# ── ADPICK BIZ affiliate (서버 전용 선택) ─────────────────────
# ADPICK BIZ API KEY 관리에서 발급한 키. 브라우저 환경변수로 노출하지 마세요.
ADPICK_API_KEY=
# true면 검색 딥링크도 directlink에 전달합니다. 기본값 false 권장.
ADPICK_ALLOW_SEARCH_URLS=false
# true면 홍보 제한 상품도 쇼핑몰로 이동시킵니다. 커미션이 없을 수 있습니다.
ADPICK_FORCEREDIRECT=false
# 데모 카탈로그의 상품 ID를 실제 제휴몰 상세 URL로 연결할 때 사용합니다.
# 예: {"pl-polo-oxford":"https://mall.example/products/123"}
STS_PRODUCT_URL_OVERRIDES_JSON=
# /api/affiliate/conversions 보호용 서버 토큰
AFFILIATE_ADMIN_TOKEN=

# ── LinkPrice affiliate (server-only) ─────────────────────────
# LinkPrice deeplink/API endpoint and credential. Never prefix these with NEXT_PUBLIC_.
LINKPRICE_API_URL=
LINKPRICE_API_KEY=
# header (default) or query. Header is safer and should be preferred when supported.
LINKPRICE_API_KEY_LOCATION=header
LINKPRICE_API_KEY_HEADER=Authorization
LINKPRICE_API_KEY_PREFIX=Bearer 
LINKPRICE_API_KEY_QUERY_PARAM=api_key
# GET or POST, depending on the LinkPrice API contract you were issued.
LINKPRICE_METHOD=GET
LINKPRICE_DESTINATION_PARAM=url
LINKPRICE_ATTRIBUTION_PARAM=p_data

# ── Sovrn Commerce (server-only, global affiliate fallback) ──
# Product Comparison API: https://developer.sovrn.com/reference/product-affiliate-api
SOVRN_API_KEY=
SOVRN_COMPARISON_SECRET=
SOVRN_SITE_API_KEY=
SOVRN_MARKET=usd_en
SOVRN_COMPARISON_URL=https://comparisons.sovrn.com/api/affiliate/v3.5/sites

# ── AliExpress Affiliate image search (server-only) ──────────
# AliExpress Open Platform 앱과 Affiliate Image Search 권한에서 발급한 값입니다.
# 이미지 API의 image_file_bytes 제한은 100KB이며 STS가 객체별 JPEG 크롭으로 맞춥니다.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_APP_SIGNATURE=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_MEDIA_USER_ID=
# 공식 TOP HTTPS endpoint. 별도 계약 URL을 받은 경우에만 변경하세요.
ALIEXPRESS_API_ENDPOINT=https://eco.taobao.com/router/rest

# Required for server-side click persistence. Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin catalog preview auth (server-only local fixture mode) ─────────────
# Local fixture/admin preview routes accept this token only through the
# x-sts-admin-token request header. Never expose it to browser storage or
# client-side JavaScript.
STS_ADMIN_TOKEN=
