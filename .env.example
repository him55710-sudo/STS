# ── Supabase 백엔드 (Phase 1 영속화) ───────────────────────────
# 설정하면 실 로그인·게시물/소셜 영속화가 활성화됩니다.
# 없으면 앱은 데모 모드(localStorage)로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
# anon/publishable 키 (sb_publishable_... 또는 legacy anon JWT) — 클라이언트 노출 안전 (RLS가 권한을 강제)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ service_role 키는 NEXT_PUBLIC_ 접두사로 절대 넣지 마세요.
#    Phase 1 코드는 service_role 키를 사용하지 않습니다 (전부 anon+RLS).
#    향후 서버 전용 관리 작업이 생기면 SUPABASE_SERVICE_ROLE_KEY(비공개)로만 추가합니다.

# 시드/데모 콘텐츠 노출 + 데모 로그인 허용 (프로덕션에서는 false 또는 미설정)
NEXT_PUBLIC_DEMO_MODE=true

# ── TikTok 통합 (Phase 4) ───────────────────────────────────────
# TikTok for Developers 앱 등록 후 발급 (https://developers.tiktok.com).
# Login Kit + Display API 승인이 필요하며, scope: user.info.basic, video.list
# ⚠️ 전부 서버 전용 — NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 앱 콘솔에 등록한 리다이렉트 URI와 정확히 일치해야 합니다.
TIKTOK_REDIRECT_URI=https://sts-mongben.vercel.app/api/integrations/tiktok/callback
# 액세스/리프레시 토큰 암호화 키 — 32바이트 hex(64자) 또는 base64.
# 생성: openssl rand -hex 32
TIKTOK_TOKEN_ENC_KEY=
# external_connections RPC 서버 시크릿 (DB provider_secrets의 'tiktok-server'와 일치)
TIKTOK_SERVER_SECRET=
# 자격증명 없이 아키텍처를 시연할 때만 true. 프로덕션(데모 off)에서는 무시됩니다.
TIKTOK_MOCK_MODE=

# ── 수익 분배 (Phase 3) ─────────────────────────────────────────
# 크리에이터 몫 (0~1). 미설정 시 0.70. UI 라벨·정산 분배 모두 이 값을 따른다.
NEXT_PUBLIC_CREATOR_SHARE=0.7
# postback 인증 시크릿은 환경변수가 아니라 DB(provider_secrets 테이블)에 있다.
# 운영 전환 시: update provider_secrets set secret='...' where provider='mock';
# (개발 기본값은 supabase/migrations/20260813000007 참조)
#
# ⚠️ 운영 전환 전 반드시 교체해야 하는 DB 시크릿 3종:
#    update provider_secrets set secret='<random>' where provider='mock';
#    update provider_secrets set secret='<random>' where provider='tiktok-server';
#    (새 제휴 provider를 추가할 때마다 같은 방식으로 행을 넣는다)

# ── 사기 방지 (Phase 7) ─────────────────────────────────────────
# 임계값은 환경변수가 아니라 코드(lib/integrity/fraud.ts)에 단일 정의되어 있다.
# 서버 라우트가 DB RPC에 파라미터로 넘기므로 SQL과 값이 어긋날 수 없다.
# 변경하려면 FRAUD_RULES 상수를 고치고 배포한다.

# ── 비전 파이프라인 (선택) ───────────────────────────────────────
# fashion_v3(기본) 대신 구버전 탐지를 강제할 때만 'legacy'로 설정한다.
# 서버(/api/detect)와 클라이언트(create 화면)가 각각 읽으므로 둘 다 맞춰야 한다.
VISION_PIPELINE=
NEXT_PUBLIC_VISION_PIPELINE=

# Gemini API 키 (선택) — 설정하면 업로드 이미지에 대해 실제 AI 객체 탐지가 동작합니다.
# 없으면 데모 mock 탐지로 자동 fallback 됩니다.
GEMINI_API_KEY=
# 탐지에 사용할 모델 (기본: gemini-3.5-flash)
GEMINI_MODEL=

# ── Letsur Platform (주 LLM provider) ──────────────────────────
# https://platform.letsur.ai — 발급받은 API 키 (sk-...)
# 설정하면 객체 탐지·상품 조사에서 Gemini보다 우선 사용됩니다.
LETSUR_API_KEY=
# base URL. 비워두면 자동 probe 합니다.
# 프로덕션 실측: https://api.letsur.ai/v1 만 실제 API 응답을 반환했습니다.
LETSUR_BASE_URL=https://api.letsur.ai/v1
# 인증 헤더 방식: bearer | x-api-key. 비우면 둘 다 시도 후 성공한 쪽을 사용합니다.
LETSUR_AUTH_STYLE=
# 사용할 모델 ID (/api/vision-health 의 availableModels 에서 비전 지원 모델 선택)
LETSUR_MODEL=
# 관리(Management) API 키 (mk_...) — 스페이스/모델 조회 진단용. 비전 호출에는 쓰지 않음.
LETSUR_MANAGEMENT_KEY=

# provider 강제 지정 (비교·롤백용): letsur | gemini. 비우면 letsur → gemini 순서.
LLM_PROVIDER=

# ── 네이버 검색 API (선택) — 상품 후보 시각 검증용 ──────────────
#
# ⚠️ 쇼핑 검색 API는 종료되었습니다.
#    네이버 개발자센터 이용약관 부칙 제2조 ③ (시행 2026-07-31):
#    "Search API 중 '쇼핑', '책', '학술정보' 서비스는 2026-07-31 24:00부로 종료"
#    → /v1/search/shop.json 은 키를 바꿔도 되살아나지 않습니다. 호출하지 않습니다.
#
# 현재 쓰는 것: **이미지 검색**. 상품명으로 실제 상품 이미지를 찾아 대표색을 서버에서
# 계산하고, 업로드 사진의 마스크 색과 비교해 재랭킹의 visual 축을 채웁니다.
# (검색 이미지는 제3자 저작물이므로 점수 계산에만 쓰고 화면에 노출하지 않습니다.)
#
# 계약(contract)이 두 가지입니다. 아무것도 지정하지 않으면 둘 다 시도합니다.
#
# [1] apihub — 신규. NAVER API HUB (네이버클라우드플랫폼 콘솔에서 발급)
#     https://naverapihub.apigw.ntruss.com/search/v1/{type}
#     헤더 X-NCP-APIGW-API-KEY-ID / X-NCP-APIGW-API-KEY
NAVER_APIGW_API_KEY_ID=
NAVER_APIGW_API_KEY=
#
# [2] legacy — 구 개발자센터 (2027-06-30 종료 예정)
#     https://openapi.naver.com/v1/search/{type}.json
#     헤더 X-Naver-Client-Id / X-Naver-Client-Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
#
# 계약 강제 지정 (진단·롤백용): apihub | legacy. 비우면 자동 판별 후 캐시.
NAVER_API_CONTRACT=

# 참고: GEMINI_API_KEY가 무료 티어면 일일 쿼터(요청 수)가 작아
# 정밀 탐지·웹 상품 검색(구글 검색 그라운딩)이 자주 429로 막힙니다.
# 프로덕션에서는 유료(pay-as-you-go) 전환을 권장합니다.
